{
	// Review authors (login, case-insensitive, optional "[bot]") or exact check
	// names that must have reviewed. QA Department writes the PR's QA Status
	// block (or the workflow stamps `Depth: skip (<reason>)` for eligible
	// docs-only/non-runtime PRs). `ship-pr` passes the synthetic `qa-department`
	// review entry only when Verdict is PASS, Depth satisfies the workflow profile,
	// Head equals headRefOid, and For you to test is none (see
	// .agents/skills/ship-pr/SKILL.md and docs/merge-policy.md).
	"reviewers": {
		"low": ["qa-department"],
		"medium": ["qa-department"],
		"high": ["qa-department"]
	},
	// High risk always waits for the owner.
	"humanApprovalFor": ["high"],
	// Tiers the agent may merge with --merge once the gates above pass.
	"autoMergeFor": ["low", "medium"],
	// The repo merges with merge commits.
	"mergeMethod": "merge",
	// Production deploy to Fly.io is currently manual; wire up a running-version
	// check once automated Fly deploy + health check are added to release.yml.
	"deployCheck": null
}
